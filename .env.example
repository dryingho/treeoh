# portfolio-incident-lab 환경 변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# [중요] 이 값들은 전부 "가상 실습용"이며 실제 서비스/계정이 아니다.

# ── Django ────────────────────────────────────────────────
# 실습 기본값은 base(안전). 취약 실습은 반드시 명시적으로 선택해야 한다:
#   DJANGO_SETTINGS_MODULE=config.settings.vulnerable
DJANGO_SETTINGS_MODULE=config.settings.vulnerable
DJANGO_SECRET_KEY=lab-insecure-secret-key-do-not-reuse
DJANGO_DEBUG=1
# 로컬 VM 에서 접근할 호스트명 (쉼표 구분)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,treeoh.dryingho.com

# ── PostgreSQL (관리/마이그레이션용 전체 권한 계정) ───────────
# 이 계정은 Django 앱이 마이그레이션과 전체 테이블 접근에 사용한다.
# Docker 미사용(네이티브) 기준: 로컬 PostgreSQL 에 접속한다.
# PostgreSQL 은 기본값(localhost)만 바인딩하여 호스트/외부에 공개하지 않는다.
POSTGRES_DB=portfolio_lab
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=lab_admin_pw_change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── 유출용 "최소 권한" 계정 (Git 이력에 하드코딩되는 값) ──────
# 이 계정은 demo_records 테이블만 SELECT 가능하도록 제한된다.
# create_lab_git_history.sh 의 1차 커밋에 하드코딩되어 "과거 노출" 재현.
LAB_LEAK_DB_USER=app_legacy
LAB_LEAK_DB_PASSWORD=legacy_pw_exposed_in_git_2019

# ── 업로드 파일 실행 (Django 가 직접 실행) ───────────────────
# 업로드한 .sh/.cgi 는 /uploads/run/<파일> 주소에서 Django 가 직접 실행한다.
# (취약 모드에서만 실행. 수정 모드는 소스만 보여줌.)
# 아래는 변조 링크를 만들 때 쓰는 베이스 URL (보통 Django 주소와 동일).
LAB_RUN_BASE_URL=http://localhost:8000

# ── 로컬 공격자 수집기 (모의) ────────────────────────────────
# 탈취된 쿠키를 받는 "공격자 서버"를 VM 내부에 로컬로 모의한다.
# 외부 수집 서버로 전송하지 않는다.
LAB_COLLECTOR_URL=http://localhost:8000/lab/collector/
