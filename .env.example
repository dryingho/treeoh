# portfolio-incident-lab 환경 변수 예시 (전부 가상 실습용 값)
#   cp .env.example .env
#
# DB 는 장고 내장 SQLite(db.sqlite3) — 설정할 값이 없다(파일 하나, 자동 생성).

# 실행 모드: vulnerable(취약) / safe(안전, 기본). 설정 안 하면 safe 로 동작.
LAB_MODE=vulnerable

# 세션 쿠키 서명 키(Django 기본 용도).
DJANGO_SECRET_KEY=example

# DB 민감 필드(연락 메모·실습 비밀번호) 암호화 키(Fernet).
LAB_DB_ENC_KEY=example

DJANGO_DEBUG=1

# 접근 허용 호스트 / CSRF 신뢰 출처 (쉼표 구분. 커스텀 도메인·HTTPS 접속 시 필요)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,http://example.com

# 업로드 파일 실행 주소를 만들 때 쓰는 베이스 URL (보통 Django 주소와 동일)
LAB_RUN_BASE_URL=http://localhost:8000
